# Copy to .env and fill in. Never put real secrets in this file — it is meant to be committed.

# From @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token
# Comma-separated Telegram user ids. This is the lockout-proof floor for admin access.
ADMIN_IDS=

DATABASE_URL=sqlite+aiosqlite:///./local.db
REDIS_URL=redis://localhost:6379/0

# Supergroup with Topics enabled; add the bot as an admin with "Manage Topics".
# Supergroup ids start with -100. If the group was upgraded from a basic group its id CHANGED —
# re-read it with `python -m scripts.get_chat_id` rather than reusing the old one.
SUPPORT_GROUP_ID=
LOG_CHAT_ID=

DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
