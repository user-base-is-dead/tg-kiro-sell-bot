# ── Order threads ────────────────────────────────────────────────────────────────────────
# The forum group (topics must be ON) where EVERY order opens its own thread. Create the group,
# add the bot as an admin with "Manage topics", then paste the group id here — it looks like
# -1001234567890. Get it with `python scripts/get_chat_id.py`.
#
#   order placed        → a thread opens here and logs everything that happens to the order
#   order delivered     → the thread closes itself
#   cancelled/refunded  → the thread STAYS open and the buyer is connected to it: they just type
#                         in the bot chat and it lands here. Reply in the thread to answer them.
#                         Run /close in the thread when it's settled.
#
# Leave blank to turn order threads off entirely (refunds then fall back to a normal support ticket).
ORDERS_GROUP_ID=
LOG_CHAT_ID=

COMMUNITY_GROUP_URL=https://t.me/exonmarketplace
