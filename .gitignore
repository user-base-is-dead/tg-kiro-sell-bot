# secrets / environment — no .env file of any kind is ever committed. An example file with real
# values in it is how the bot token got published once; there is no exception for one any more.
.env
.env.*

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local sqlite db
*.db
*.db-journal
# Timestamped backups the migration scripts leave behind — `*.db` misses these because the suffix
# lands after the extension (local.db.bak-20260810-054650).
*.db.bak-*

# scratch output
out*.txt

# logs — and the rotated copies RotatingFileHandler leaves beside them (bot.log.1, bot.log.2, …)
*.log
*.log.*

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
